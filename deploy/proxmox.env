# rspaced.g8.lo provisioning config (g8.lo lab — no secrets).
# Consumed by deploy/_lib.sh.

PVE_HOST=root@pve.g8.lo
PVE_STORAGE=local-lvm
PVE_BRIDGE=vmbr0
PVE_IMG=/var/lib/vz/template/iso/Fedora-Cloud-Base-Generic-43-1.6.x86_64.qcow2
PVE_SNIPPETS=/var/lib/vz/snippets

# Target VM — the build/run/control host.
VMID=120
VM_NAME=rspaced.g8.lo
VM_HOST=rspaced
VM_IP=192.168.8.160
VM_GW=192.168.8.1
VM_DISK_GB=64          # OS root disk (wipeable)
VM_DATA_GB=800         # persistent data disk -> /data (store + repos); thin
VM_MEMORY_MB=16384
VM_CORES=8

# DNS — the g8 MicroDNS (same the other projects use).
MICRODNS_URL=http://192.168.8.252:8080/api/v1
G8_ZONE_ID=9bed60c8-1664-4183-88f9-a1a21b927edc
