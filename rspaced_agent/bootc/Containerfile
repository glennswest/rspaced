# rspaced_agent — minimal FROM-scratch bootc image (milestone 1).
#
# NO full OS distro baked in. A builder stage generates a *minimal* rootfs
# (bootc + systemd + kernel + dnf + hard deps) via bootc-base-imagectl; we then
# REPLACE its kernel with the RHCOS kernel for the specced OCP version (sourced
# from our rhel-coreos image, so it's the same kernel as the release), and
# `FROM scratch` assemble the result + console kargs + a hello banner.
#
# Kernel/initramfs live at /usr/lib/modules/$kver/{vmlinuz,initramfs.img}
# (bootc handles /boot). Console/kargs are bootc-native (kargs.d) — NEVER
# coreos-installer. podman->rspacefs storage.conf is a later milestone.
#
# Build (privileged podman, per bootc docs + forcicd#3):
#   podman build --cap-add=all \
#     --security-opt=label=type:container_runtime_t --device /dev/fuse \
#     --build-arg RHCOS=<version-pinned rhel-coreos digest ref> -t <ref> .

ARG BUILDER=quay.io/centos-bootc/centos-bootc:stream9
# Override with the version-pinned rhel-coreos digest (from our content /
# the release provenance), e.g. quay.io/openshift-release-dev/ocp-v4.0-art-dev@sha256:...
ARG RHCOS=quay.io/openshift-release-dev/ocp-v4.0-art-dev:rhel-coreos

FROM ${BUILDER} AS builder
RUN /usr/libexec/bootc-base-imagectl build-rootfs --manifest=minimal /target-rootfs

# RHCOS kernel source — the kernel for the specced OCP version.
FROM ${RHCOS} AS rhcos

FROM scratch
COPY --from=builder /target-rootfs/ /

# Same kernel as the OCP release: drop the minimal-manifest kernel, use RHCOS's.
RUN rm -rf /usr/lib/modules/*
COPY --from=rhcos /usr/lib/modules/ /usr/lib/modules/

# tty0 + serial console (serial primary), bootc-native.
COPY kargs.d/10-console.toml /usr/lib/bootc/kargs.d/10-console.toml
# hello-world boot banner.
COPY hello-rspaced.service /usr/lib/systemd/system/hello-rspaced.service
RUN systemctl enable hello-rspaced.service && bootc container lint

LABEL containers.bootc="1"
LABEL ostree.bootable="1"
LABEL org.rspaced.agent="hello-world"
ENV container=oci
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
